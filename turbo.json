{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "test": {
      "cache": false,
      "passThroughEnv": [
        "STUDIO_TEST_DATABASE_URL",
        "STUDIO_TEST_RENDER_IMAGE",
        "STUDIO_TEST_CHROME",
        "STUDIO_NATIVE_EVIDENCE_DIR"
      ]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    }
  }
}
