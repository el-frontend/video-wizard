# Copy to .env.docker, restrict its permissions and set the PostgreSQL password
# in both fields. URL-encode special characters in DATABASE_URL.
POSTGRES_USER=videowizard
POSTGRES_PASSWORD=
POSTGRES_DB=videowizard
DATABASE_URL=postgresql://videowizard:@postgres:5432/videowizard

# Generate each secret independently (openssl rand -base64 48).
BETTER_AUTH_SECRET=
STUDIO_RENDER_SECRET=
BETTER_AUTH_URL=http://app.video-wizard.localhost:3000
STUDIO_EDITOR_ORIGIN=http://app.video-wizard.localhost:3000
STUDIO_PREVIEW_ORIGIN=http://preview.video-wizard.localhost:3001
REMOTION_SERVER_URL=http://remotion-server:3001
PYTHON_ENGINE_INTERNAL_URL=http://processing-engine:8000
STUDIO_DATA_DIR=/app/.studio-data

# Optional when using local Whisper and manual clip ranges.
USE_OPENAI_API=false
OPENAI_API_KEY=
