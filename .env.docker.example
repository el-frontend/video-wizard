# Copy this file to .env.docker (gitignored) and edit the values.
# `docker compose up` reads from .env.docker for every service.

# -----------------------------------------------------------------------------
# PostgreSQL — used by `postgres`, `migrate`, `web` and `worker` services.
# -----------------------------------------------------------------------------
POSTGRES_USER=videowizard
POSTGRES_PASSWORD=videowizard
POSTGRES_DB=videowizard

# Connection URL used by every container (resolves `postgres` via the
# compose network). For the host (e.g. local pnpm dev), use localhost
# in apps/web/.env.local instead.
DATABASE_URL=postgresql://videowizard:videowizard@postgres:5432/videowizard

# -----------------------------------------------------------------------------
# Auth.js — required.
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace_with_a_random_32_byte_base64_string

# -----------------------------------------------------------------------------
# AI / external APIs.
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-replace_me

# -----------------------------------------------------------------------------
# Service URLs — wired for inside-Docker communication. Don't change unless
# you know what you're doing.
# -----------------------------------------------------------------------------
# Public (browser hits this — port-mapped to host).
NEXT_PUBLIC_PYTHON_ENGINE_URL=http://localhost:8000
# Server-side container-to-container.
PYTHON_ENGINE_INTERNAL_URL=http://processing-engine:8000
REMOTION_SERVER_URL=http://remotion-server:3001
