# Server Configuration
PORT=3001

# Public URL for accessing rendered videos
# In production, set this to your domain (e.g., https://yourdomain.com)
PUBLIC_URL=http://localhost:3001

# Remotion Configuration
# Optional: If you have a pre-bundled Remotion project, set this URL
# Otherwise, the server will bundle the compositions on startup
REMOTION_SERVE_URL=

# Renders directory (where output videos are stored)
RENDERS_DIR=./renders

# Private Studio renderer. Generate one random secret and configure the same value in Next.
STUDIO_RENDER_SECRET=
STUDIO_EDITOR_ORIGIN=http://localhost:3000
STUDIO_PREVIEW_ORIGIN=http://localhost:3001
# Optional installed Chromium executable for local rendering.
# REMOTION_BROWSER_EXECUTABLE=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
