# Host development. Use the credentials and port of your PostgreSQL instance.
DATABASE_URL=postgresql://videowizard:@127.0.0.1:5432/videowizard
BETTER_AUTH_URL=http://localhost:3000
# Generate two independent secrets with openssl rand -base64 48.
BETTER_AUTH_SECRET=
STUDIO_RENDER_SECRET=

# Server-side only. The renderer and the processor share STUDIO_RENDER_SECRET.
PYTHON_ENGINE_INTERNAL_URL=http://127.0.0.1:8000
REMOTION_SERVER_URL=http://127.0.0.1:3001
# STUDIO_DATA_DIR=/absolute/path/to/private/studio-data
# Optional for analysis and hosted transcription.
OPENAI_API_KEY=

# Optional auth:seed inputs. Omit the password to generate a private credential.
# SEED_USER_EMAIL=demo@video-wizard.local
# SEED_USER_NAME=Usuario de prueba
# SEED_USER_PASSWORD=
