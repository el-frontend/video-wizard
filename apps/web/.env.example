# OpenAI API Key for AI features
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Python Processing Engine URL (client-side, prefixed with NEXT_PUBLIC_)
NEXT_PUBLIC_PYTHON_ENGINE_URL=http://localhost:8000

# Remotion Render Server URL (server-side)
REMOTION_SERVER_URL=http://localhost:3001

# Python Engine URL for Docker container-to-container communication
PYTHON_ENGINE_INTERNAL_URL=http://processing-engine:8000

# PostgreSQL Database URL
# Matches credentials from root .env.docker
DATABASE_URL=postgresql://videowizard:videowizard@localhost:5432/videowizard

# Auth.js (NextAuth v5) — required
# Generate with: openssl rand -base64 32   (or: pnpm dlx auth secret)
AUTH_SECRET=replace_with_a_random_32_byte_base64_string

# Auth.js public URL (set in production; auto-detected in Vercel/dev)
# AUTH_URL=http://localhost:3000

# Magic-link email "from" address shown to recipients
AUTH_EMAIL_FROM=noreply@video-wizard.local

# Resend API key for production magic-link delivery (optional in dev)
# When unset, magic links are printed to the server console for local testing.
# Get a key at: https://resend.com/api-keys
# AUTH_RESEND_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx
